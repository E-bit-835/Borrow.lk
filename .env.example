# BorrowLK Environment Variables (Template)

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"
NEON_BRANCH=production

# Security & Authentication (required — change in production)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Host / provider applications: "true" = wait for admin approval, anything else = approved instantly
REQUIRE_PARTNER_APPROVAL=false

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email / OTP (password reset & email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BorrowLK
SMTP_FROM_EMAIL=

# AI assistant (/ai-assistant). Any OpenAI-compatible chat API works.
# Leave all three empty to use GEMINI_API_KEY (Google's free tier).
# Groq (free tier, open-source Llama models): get a key at https://console.groq.com
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=your-groq-key
#   AI_MODEL=llama-3.3-70b-versatile   (check Groq's current model list)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Google Gemini AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI and Machine Learning Configuration
OPEN_SOURCE_AI_PROVIDER=open_source_pipeline
OPEN_SOURCE_AI_MODEL=meta-llama/Llama-3.2-3B-Instruct
HUGGINGFACE_API_KEY=

# Custom Machine Learning Model
CUSTOM_ML_MODEL_NAME=BorrowLK-RentalIntelligence-Ensemble
CUSTOM_ML_MODEL_VERSION=v2.4.1

# Frontend API URL
# Leave empty in local Vite dev to use the /api proxy (recommended).
# Or set: VITE_API_URL=http://127.0.0.1:5000/api
VITE_API_URL=
